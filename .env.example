# Global discrepancy tolerance (as a decimal, e.g. 0.05 = 5%).
# Falls back to 0.05 if unset. Can be overridden per-carrier in mock-api/server.js
# via the CARRIER_TOLERANCES map.
DISCREPANCY_TOLERANCE=0.05

# Port the mock API server listens on.
API_PORT=4000

# Port the downstream carrier rate-lookup service listens on.
RATE_SERVICE_PORT=4001

# Base URL the mock API uses to call the downstream rate-lookup service.
RATE_SERVICE_URL=http://localhost:4001

# --- Qase (optional — only needed for `npm run qase:setup` and `npm run test:qase`) ---
# Personal API token from Qase → Personal profile → API tokens. Never commit this.
QASE_TESTOPS_API_TOKEN=
# Project code in Qase (created fresh by scripts/qase-setup.mjs).
QASE_TESTOPS_PROJECT_CODE=CARGO
# Set to "testops" to have `npm run test:qase` report results into Qase.
# NOTE: leave this UNSET/commented here — `npm run test:qase` sets it for you
# via cross-env. If you set it here, plain `npm test` would also report to
# Qase (since .env now loads automatically), breaking the offline default.
# QASE_MODE=testops
